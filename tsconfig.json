{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2020",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "outDir": "dist",
    "rootDir": "src",
    "typeRoots": ["./src/@types", "./node_modules/@types"]
  },
  "include": ["src"]
}
