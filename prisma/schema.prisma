generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model TravelProperties {
  id          Int  @id @default(autoincrement()) @db.UnsignedInt
  location_id Int  @db.UnsignedInt
  layout_id   Int  @db.UnsignedInt
  rating_id   Int? @db.UnsignedInt

  name            String
  slug            String
  suspended       Int
  top             Int
  meta_content    String? @db.Text
  metadata         Json?
  iv_reference_id Int?    @db.UnsignedInt

  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  deleted_at DateTime? @db.Timestamp(0)

  //relations
  page   Pages   @relation(fields: [location_id], references: [id])
  layout Layouts @relation(fields: [layout_id], references: [id])
  rating ListsRatings? @relation(fields: [rating_id], references: [id])

  @@index([iv_reference_id])
  @@map("travel_properties")
}

model ListsRatings {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  name       String    @unique(map: "lists_ratings_name_unique")
  iv_code    Int?
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  travelProperties TravelProperties[] 

  @@map("lists_ratings")
}

model Pages {
  id         Int       @id @default(autoincrement())
  parent_id  Int?
  layout_id  Int?
  name       String?
  slug       String?
  identifier String?
  metadata   String?   @db.LongText
  active     Boolean?
  created_at DateTime? @db.Timestamp(0)
  travelProperties TravelProperties[] 

  @@map("pages")
}

model Layouts {
  id   Int     @id @default(autoincrement())
  name String?

  @@map("layouts")
  travelProperties TravelProperties[] 
}

model queryerrorlog {
  id           Int       @id @default(autoincrement())
  model        String?   @db.VarChar(255)
  tableName    String?   @db.VarChar(255)
  action       String?   @db.VarChar(255)
  query        String    @db.Text
  params       String?   @db.Text
  errorType    String    @db.VarChar(255)
  errorMessage String    @db.Text
  stack        String?   @db.Text
  durationMs   Int?
  createdAt    DateTime? @default(now()) @db.DateTime(0)
}

model slowquerylog {
  id         Int       @id @default(autoincrement())
  model      String?   @db.VarChar(255)
  tableName  String?   @db.VarChar(255)
  action     String?   @db.VarChar(255)
  query      String    @db.Text
  params     String?   @db.Text
  durationMs Int
  createdAt  DateTime? @default(now()) @db.DateTime(0)
}

model RedisLog {
  id        Int      @id @default(autoincrement())
  command   String
  args      String?  @db.LongText
  status    String
  duration  Int?
  error     String?
  createdAt DateTime @default(now())

  @@map("redis_logs")
}

model IvRequestLog {
  id          Int      @id @default(autoincrement())
  url         String
  method      String
  requestBody String?  @db.LongText
  statusCode  Int?
  durationMs  Int
  status      String
  error       String?
  createdAt   DateTime @default(now())

  @@map("ivector_logs")
}

model airport {
  id   Int    @id @default(autoincrement())
  name String
}

model destination {
  id                Int           @id @default(autoincrement())
  name              String
  metadata          String        @db.LongText
  active            Boolean       @default(true)
  parentId          Int?
  destination       destination?  @relation("destinationTodestination", fields: [parentId], references: [id], map: "Destination_parentId_fkey")
  other_destination destination[] @relation("destinationTodestination")
  property          property[]
  region            region[]

  @@index([parentId], map: "Destination_parentId_fkey")
}

model property {
  id            Int         @id @default(autoincrement())
  name          String
  destinationId Int
  regionId      Int
  address       String
  contactNumber String
  description   String
  isActive      Boolean     @default(true)
  destination   destination @relation(fields: [destinationId], references: [id], map: "Property_destinationId_fkey")
  region        region      @relation(fields: [regionId], references: [id], map: "Property_regionId_fkey")

  @@index([destinationId], map: "Property_destinationId_fkey")
  @@index([regionId], map: "Property_regionId_fkey")
}

model region {
  id            Int         @id @default(autoincrement())
  name          String
  metadata      String      @db.LongText
  active        Boolean     @default(true)
  parentId      Int?
  destinationId Int
  property      property[]
  destination   destination @relation(fields: [destinationId], references: [id], map: "Region_destinationId_fkey")
  region        region?     @relation("regionToregion", fields: [parentId], references: [id], map: "Region_parentId_fkey")
  other_region  region[]    @relation("regionToregion")

  @@index([destinationId], map: "Region_destinationId_fkey")
  @@index([parentId], map: "Region_parentId_fkey")
}

model requestLog {
  id        Int      @id @default(autoincrement())
  endpoint  String
  ipAddress String
  createdAt DateTime @default(now())
}

model systemLog {
  id        BigInt @id @default(autoincrement())
  parentId  String?
  source    String
  action    String?
  endpoint  String?
  method    String?
  query     String?
  payload   Json?
  status    String
  duration  Int?
  error     String?
  createdAt DateTime @default(now())

  @@index([parentId], map: "SystemLog_parentId_idx")
}
